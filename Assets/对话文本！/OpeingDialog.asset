    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u4F60"
    Content: "\u6211\u611F\u5230\u8840\u8109\u6DF1\u5904\uFF0C\u4F3C\u6709\u65E0\u540D\u4E4B\u7269\u6D41\u52A8\u2026\u2026"
