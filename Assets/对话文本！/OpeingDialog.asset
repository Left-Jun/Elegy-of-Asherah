    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u4E5F\u662F\u552F\u4E00\u80FD\u5C06\u5176\u5E26\u56DE\u6BCD\u6811\u4E4B\u4EBA\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u4F60"
    Content: "\u4E9A\u820D\u62C9\u2026\u6BCD\u4EB2\u4E4B\u6811\uFF1F\u4E3A\u4F55\u6B64\u95F4\uFF0C\u5982\u6B64\u5BC2\u9759\uFF1F"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u7075\u80FD\u7684\u8109\u8F6E\u5DF2\u7136\u505C\u6EDE\u3002\u4E16\u754C\u5DF2\u6C89\u5165\u201C\u6839\u8109\u8870\u4EA1\u4E4B\u7EAA\u201D\u2014\u2014\u88AB\u79F0\u4E3A\u201C\u5927\u67AF\u840E\u7EAA\u201D\u7684\u6F2B\u957F\u9EC4\u660F\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u6BCD\u6811\u6B8B\u5B58\u7684\u610F\u8BC6\uFF0C\u4E3A\u4F60\u7EF4\u7CFB\u8FD9\u7247\u6700\u540E\u7684\u5B89\u5B81\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u542C\u6E05\u695A\uFF0C\u5B69\u5B50\u3002\u82E5\u4F60\u79BB\u53BB\u6B64\u5730\uFF0C\u7075\u80FD\u4FBF\u5982\u6D41\u6C99\uFF0C\u81EA\u4F60\u547D\u8109\u4E2D\u6D88\u901D\u3002\u5F53\u5B83\u6D41\u5C3D\uFF0C\u4F60\u4FBF\u5982\u6C99\u5854\u822C\u5D29\u584C\uFF0C\u5F52\u4E8E\u5C18\u571F\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u4F60"
    Content: "\u6211\u5F53\u5982\u4F55\u5B58\u6D3B\uFF1F"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u5411\u4E0B\u3002\u6B65\u5165\u90A3\u7247\u5D29\u673D\u7684\u6839\u987B\u8FF7\u5BAB\uFF0C\u62FE\u53D6\u5176\u4E2D\u6563\u843D\u7684\u7075\u80FD\u4F59\u70EC\uFF0C\u6536\u96C6\u5B83\u4EEC\uFF0C\u5EF6\u7EED\u4F60\u7684\u5B58\u5728\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u4E5F\u5E26\u8D70\u6BCD\u6811\u9057\u843D\u7684\u5723\u9AA8\uFF08\u4E9A\u820D\u62C9\u9057\u9AA8\uFF09\uFF0C\u552F\u6709\u7942\u7684\u9057\u9AA8\uFF0C\u80FD\u5728\u4E9A\u820D\u62C9\u67AF\u69C1\u7684\u8EAF\u5E72\u4E0A\uFF0C\u91CD\u94F8\u901A\u8DEF\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u5F53\u4F60\u6536\u96C6\u8DB3\u591F\u4E4B\u7269\u2014\u2014\u56DE\u5230\u5730\u8868\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
