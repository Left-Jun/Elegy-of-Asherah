    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u8046\u542C\u6839\u8109\u4F4E\u8BED\u4E4B\u4EBA\uFF0C\u627F\u8F7D\u7075\u80FD\u6D41\u52A8\u4E4B\u4EBA\u3002"
    AutoNext: 0
