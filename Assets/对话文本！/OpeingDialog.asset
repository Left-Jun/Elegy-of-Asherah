    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u800C\u540E\u5411\u4E0A\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u4F60"
    Content: "\u5411\u4E0A\uFF1F"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u643A\u4F60\u6240\u96C6\u7684\u4E00\u5207\uFF0C\u6500\u4E0A\u4E9A\u820D\u62C9\u5316\u4E3A\u7EDD\u58C1\u7684\u8EAF\u5E72\uFF0C\u5728\u7942\u5782\u6B7B\u7684\u8109\u7EDC\u4E0A\uFF0C\u91CD\u7B51\u901A\u5F80\u82CD\u7A79\u7684\u9053\u8DEF\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u4F60"
    Content: "\u82E5\u6211\u505C\u4E0B\u5462\uFF1F"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u7075\u80FD\u4F1A\u7EE7\u7EED\u6D41\u901D\u3002\u65E0\u8BBA\u5730\u4E0A\uFF0C\u8FD8\u662F\u6811\u4E0A\u2014\u2014\u65F6\u95F4\uFF0C\u4ECE\u4E0D\u5BBD\u6055\u8FDF\u7591\u4E4B\u4EBA\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u76F4\u81F3\u91CD\u8FD4\u7942\u6C89\u5BC2\u7684\u5FC3\u810F\u2014\u2014\u90A3\u6811\u51A0\u4E4B\u5DC5\uFF0C\u5C06\u4F60\u6240\u643A\u7684\u4E00\u5207\u7075\u80FD\u2014\u2014\u5F52\u8FD8\u4E8E\u5F7C\u5904\u3002\u90A3\u662F\u6B64\u884C\u552F\u4E00\u7684\u610F\u4E49\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u4E5F\u662F\u8FD9\u4E2A\u4E16\u754C\u6700\u540E\u7684\u53EF\u80FD\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u4F60"
    Content: "\u82E5\u6211\u8E0F\u4E0A\u6B64\u9014\uFF0C\u5C06\u8FCE\u6765\u600E\u6837\u7684\u7EC8\u5C40\uFF1F"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u65B0\u8109\u6216\u5C06\u518D\u751F\uFF0C\u6216\u2026\u2026\u4F60\u7684\u5BBF\u547D\u65E9\u5DF2\u94ED\u523B\u5728\u6839\u987B\u6DF1\u5904\u3002\u4F60\u53EA\u9700\u524D\u884C\uFF0C\u6B65\u5165\u90A3\u67AF\u840E\u7684\u9EC4\u660F\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u542F\u7A0B\u5427\u3002\u5E87\u62A4\u4E4B\u5730\u5373\u5C06\u6D88\u6563\u3002\u5728\u4E07\u7269\u5F52\u4E8E\u6C38\u5BC2\u4E4B\u524D\uFF0C\u4E3A\u6BCD\u6811\u732E\u4E0A\u7942\u7684\u8840\u8109\u3002"
