    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u90A3\u662F\u201C\u7075\u80FD\u201D\uFF0C\u8FD9\u662F\u4F60\u4E0E\u751F\u4FF1\u6765\u7684\u8840\u8109\uFF0C\u4E5F\u662F\u6BCD\u6811\u2014\u2014\u4E9A\u820D\u62C9\u2014\u2014\u6700\u540E\u7684\u6C14\u606F\uFF0C\u5728\u4F60\u8EAB\u4E2D\u56DE\u8361\u7684\u4F59\u54CD\u3002"
    AutoNext: 0
    NeedTyping: 0
    CanQuickShow: 0
    textColor: {r: 0.3019608, g: 0.18431373, b: 0.06666667, a: 0}
    fontSize: 0
    fontStyle: 0
    charDelay: 0
    choices: []
  - Speaker: "\u6816\u679D"
    Content: "\u800C\u4F60\u2014\u2014\u662F\u8FD9\u4E16\u4E0A\u6700\u540E\u4E00\u540D\u201C\u6839\u8BED\u8005\u201D\u3002"
